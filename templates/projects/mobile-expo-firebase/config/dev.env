# Môi trường DEV — chạy trên máy với bộ giả lập Firebase (Emulator).
# Dữ liệu là dữ liệu thử, KHÔNG đụng gì bên ngoài. Không cần sửa file này.
# Dùng bởi: npm start | npm run build (mặc định là dev)
USE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-khung-du-an
FIREBASE_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-khung-du-an.firebaseapp.com
FIREBASE_APP_ID=demo-app-id
