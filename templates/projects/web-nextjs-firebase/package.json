{
  "name": "khung-du-an-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --only auth,firestore --project demo-khung-du-an \"next dev\"",
    "build": "next build",
    "check": "tsc --noEmit && eslint . && vitest run && npm run test:rules",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-khung-du-an \"vitest run --config vitest.rules.config.ts\"",
    "deploy": "next build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "firebase-tools": "^15.32.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
