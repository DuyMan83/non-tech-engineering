# Môi trường PRODUCTION — app thật, dữ liệu THẬT của người dùng.
# Dùng bởi: npm start production | npm run build production | npm run deploy
#
# Firebase: Firebase console → ⚙ Project settings → General → Your apps → Web app → Config.
#   (App Expo dùng Firebase JS SDK nên lấy cấu hình của "Web app".)
# Các giá trị này KHÔNG phải bí mật — bảo mật thật nằm ở firestore.rules.
# TUYỆT ĐỐI không ghi vào đây: mật khẩu, service account, private key, key API trả phí.
USE_EMULATORS=false
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# EAS (build + cập nhật app): chạy `npx eas-cli@latest init` một lần, rồi chép "projectId" vào đây.
EAS_PROJECT_ID=
