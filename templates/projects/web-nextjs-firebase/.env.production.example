# Copy thành `.env.production.local` (KHÔNG commit) và điền cấu hình Firebase thật
# (Firebase console → Project settings → Your apps → Web app). Dùng khi `npm run build` / `npm run deploy`.
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
