# Môi trường PRODUCTION — app thật trên mạng, dữ liệu THẬT của người dùng.
# Dùng bởi: npm run build production | npm start production | npm run deploy
#
# Điền từ Firebase console → ⚙ Project settings → General → Your apps → Web app → SDK setup and configuration (Config).
# Các giá trị này KHÔNG phải bí mật (trình duyệt nào cũng thấy) — bảo mật thật nằm ở firestore.rules.
# TUYỆT ĐỐI không ghi vào đây: mật khẩu, service account, private key, key API trả phí.
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
