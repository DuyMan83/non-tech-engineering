# Dùng khi chạy `npm run dev`: Firebase Emulator trên máy, dự án demo — KHÔNG đụng dữ liệu thật.
# Các giá trị này không phải bí mật.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-khung-du-an.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-khung-du-an
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
